# Copy to .env for local development. On Render, set these under Environment.

NODE_ENV=development
PORT=5000

# --- Database ---------------------------------------------------------------
# mongodb (the default; MongoDB Atlas) or memory (no database; data is lost on restart).
DB_DRIVER=mongodb

# MongoDB (DB_DRIVER=mongodb). Atlas > your cluster > Connect > Drivers, then put in the
# database user's password. Collections and indexes are created automatically.
# For a local MongoDB use mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sumedha_agro

# --- Security ---------------------------------------------------------------
# Comma-separated list of sites allowed to call the API (your Vercel and custom domains).
# Leave empty in development to allow any origin.
CORS_ORIGIN=http://localhost:5173
# Password for the admin panel at <website>/admin. Use a long passphrase.
ADMIN_PASSWORD=Sumedha@1234
# Optional key for scripts (send as "x-admin-key" header).
ADMIN_API_KEY=

# --- Media storage (Cloudinary) ---------------------------------------------
# Cloudinary console > Settings > API Keys: copy the "API environment variable".
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Folder for this site's uploads in your Cloudinary media library.
CLOUDINARY_FOLDER=sumedha-agro

# --- Email (Resend) ---------------------------------------------------------
# resend.com > API Keys. Leave empty to save submissions without sending email.
RESEND_API_KEY=
# Sender on a domain verified in Resend (Domains). For a quick test before verifying,
# "Sumedha Agro <onboarding@resend.dev>" works but only delivers to your Resend account email.
MAIL_FROM=Sumedha Agro <info@sumedhaagro.com>
# Where new-submission notifications are sent.
COMPANY_EMAIL=info@sumedhaagro.com
